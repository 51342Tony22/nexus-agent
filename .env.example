# Replace the placeholder locally. Never commit .env.
SILICONFLOW_API_KEY=YOUR_API_KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# Set a model supported by your provider account.
SILICONFLOW_MODEL=YOUR_MODEL_ID
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=1200
SHOW_DEBUG=false
# Optional local embedding model directory:
# EMBEDDING_MODEL_PATH=/path/to/local/embedding-model
# EMBEDDING_LOCAL_FILES_ONLY=true
